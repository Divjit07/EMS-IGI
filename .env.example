# ---- App ----
PORT=3001
# Optional: where runtime JSON state is stored.
STATE_DIR=state

# ---- Gemini ----
# Used for screenshot parsing. Free-tier friendly for MVP testing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Google Sheets (Phase 1 production) ----
GOOGLE_SHEETS_API_KEY=
GUARDS_SHEET_ID=
SCHEDULE_SHEET_ID=

# ---- Google Maps (optional) ----
GOOGLE_MAPS_API_KEY=

# ---- TrackTik (Phase 2+) ----
TRACKTIK_BASE_URL=
TRACKTIK_CLIENT_ID=
TRACKTIK_CLIENT_SECRET=

# ---- Twilio (Phase 3) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_BASE_URL=
