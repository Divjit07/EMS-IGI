# ---- App ----
PORT=3001

# ---- Claude / Anthropic (optional in Phase 1) ----
# If set, uploaded screenshots are parsed by Claude.
# If empty, the app falls back to a mock parse + manual entry.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- Google Maps (optional) ----
# If empty, distances are computed locally with the Haversine formula.
GOOGLE_MAPS_API_KEY=

# ---- Data source ----
# "local"  -> use bundled JSON seed data (default, zero setup)
# "sheets" -> use Google Sheets (Phase 1 production)
DATA_SOURCE=local

# ---- Google Sheets (Phase 1 production, when DATA_SOURCE=sheets) ----
GOOGLE_SHEETS_API_KEY=
GUARDS_SHEET_ID=
SCHEDULE_SHEET_ID=

# ---- TrackTik (Phase 2+) ----
TRACKTIK_BASE_URL=
TRACKTIK_CLIENT_ID=
TRACKTIK_CLIENT_SECRET=

# ---- Twilio (Phase 3) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
